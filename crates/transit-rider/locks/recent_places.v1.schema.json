{
  "$defs": {
    "RecentPlace": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "lat": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "RecentPlacesKind": {
      "const": "recent_places"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/RecentPlacesKind",
      "default": "recent_places",
      "description": "A copy without the kind tag and version is this kind, version 1."
    },
    "places": {
      "items": {
        "$ref": "#/$defs/RecentPlace"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1
    }
  },
  "required": [
    "places"
  ],
  "title": "RecentPlaces",
  "type": "object"
}
