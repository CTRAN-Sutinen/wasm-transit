{
  "$defs": {
    "Note": {
      "additionalProperties": true,
      "properties": {
        "edited": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent until an edit."
        },
        "target": {
          "$ref": "#/$defs/NoteTarget"
        },
        "text": {
          "type": "string"
        },
        "written": {
          "$ref": "#/$defs/Stamp"
        }
      },
      "required": [
        "target",
        "text",
        "written"
      ],
      "type": "object"
    },
    "NoteTarget": {
      "oneOf": [
        {
          "description": "`start_secs` is seconds after the service-day anchor. A service date\nnames its pick, so the instance is unambiguous.",
          "properties": {
            "date": {
              "type": "string"
            },
            "kind": {
              "const": "trip",
              "type": "string"
            },
            "start_secs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "trip": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "trip",
            "date",
            "start_secs"
          ],
          "type": "object",
          "x-references": "trip_instance"
        },
        {
          "properties": {
            "id": {
              "type": "string",
              "x-references": "edit_record"
            },
            "kind": {
              "const": "edit",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string",
              "x-references": "service_alert"
            },
            "kind": {
              "const": "alert",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "stop",
              "type": "string"
            },
            "stop": {
              "type": "string",
              "x-references": "stop"
            }
          },
          "required": [
            "kind",
            "stop"
          ],
          "type": "object"
        }
      ]
    },
    "NotesKind": {
      "const": "notes"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "Stamp": {
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "by": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/NotesKind",
      "default": "notes"
    },
    "notes": {
      "additionalProperties": {
        "$ref": "#/$defs/Note"
      },
      "type": "object"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1
    }
  },
  "required": [
    "notes"
  ],
  "title": "Notes",
  "type": "object"
}
