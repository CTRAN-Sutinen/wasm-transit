{
  "$defs": {
    "AlertCause": {
      "description": "Why an alert was raised (GTFS-rt's cause, by name).",
      "enum": [
        "unknown",
        "other",
        "technical_problem",
        "strike",
        "demonstration",
        "accident",
        "holiday",
        "weather",
        "maintenance",
        "construction",
        "police_activity",
        "medical_emergency",
        "special_event"
      ],
      "type": "string"
    },
    "AlertEffect": {
      "description": "What an alert does to service (GTFS-rt's effect, by name).",
      "enum": [
        "no_service",
        "reduced_service",
        "significant_delays",
        "detour",
        "additional_service",
        "modified_service",
        "other",
        "unknown",
        "stop_moved",
        "no_effect",
        "accessibility_issue"
      ],
      "type": "string"
    },
    "AlertEntity": {
      "additionalProperties": true,
      "description": "One informed entity, in the network's ids. Every present field must\nmatch (route 12 AT stop 6277). With every field absent, it is the\nwhole agency.",
      "properties": {
        "date": {
          "description": "The trip instance's service date, \"YYYY-MM-DD\". None means the\ntrip on every date.",
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "description": "One of the route's model directions. It needs `route` (D-204).",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_type": {
          "description": "Every route published under this GTFS route type.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start_secs": {
          "description": "The trip instance's start, in seconds after the service-day\nanchor. It needs `trip`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stop": {
          "type": [
            "string",
            "null"
          ]
        },
        "trip": {
          "description": "A trip, by the model's trip id.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AlertPeriod": {
      "description": "A span of time in Unix seconds; an open end is unbounded.",
      "properties": {
        "end": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AlertSeverity": {
      "description": "How serious the agency says an alert is.",
      "enum": [
        "unknown",
        "info",
        "warning",
        "severe"
      ],
      "type": "string"
    },
    "AlertSource": {
      "description": "A disruption that an alert tells riders about.",
      "oneOf": [
        {
          "description": "A record of the edit document (a diversion or a trip cancel), by\nits record id.",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "edit",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A stop's suspension in the stops document, by the stop's lasting\nid.",
          "properties": {
            "kind": {
              "const": "stop",
              "type": "string"
            },
            "stop": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "stop"
          ],
          "type": "object"
        },
        {
          "description": "A trip instance that the live feed cancels (D-216): the model's\ntrip id, its service date (\"YYYY-MM-DD\"), and its start in seconds\nafter the service-day anchor. Version 2.",
          "properties": {
            "date": {
              "type": "string"
            },
            "kind": {
              "const": "trip",
              "type": "string"
            },
            "start_secs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "trip": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "trip",
            "date",
            "start_secs"
          ],
          "type": "object"
        }
      ]
    },
    "AlertStatus": {
      "description": "An alert's state. There is no review step (D-207): a person with\nthe write role publishes at once.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Saved, not yet told to riders.",
          "type": "string"
        },
        {
          "const": "published",
          "description": "Told to riders while a communication period holds.",
          "type": "string"
        },
        {
          "const": "retired",
          "description": "Withdrawn. It is kept, and is never told to riders.",
          "type": "string"
        }
      ]
    },
    "AlertText": {
      "description": "A text in one language. No language means the agency's default.",
      "properties": {
        "lang": {
          "description": "A BCP 47 language tag (\"en\", \"es\").",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "ServiceAlert": {
      "additionalProperties": true,
      "description": "One service alert.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/AlertCause",
          "default": "unknown"
        },
        "communication": {
          "description": "When to show it, in Unix seconds (the host converts the agency's\nlocal times; D-205). None means for as long as it is published.",
          "items": {
            "$ref": "#/$defs/AlertPeriod"
          },
          "type": "array"
        },
        "description": {
          "items": {
            "$ref": "#/$defs/AlertText"
          },
          "type": "array"
        },
        "effect": {
          "$ref": "#/$defs/AlertEffect",
          "default": "unknown"
        },
        "explains": {
          "description": "The disruptions it tells riders about: a diversion or trip\ncancel, or a suspended stop. Nothing writes an alert from these\nautomatically.",
          "items": {
            "$ref": "#/$defs/AlertSource"
          },
          "type": "array"
        },
        "header": {
          "description": "The header in each language. At least one text is not blank.",
          "items": {
            "$ref": "#/$defs/AlertText"
          },
          "type": "array"
        },
        "impact": {
          "description": "When service is affected, in Unix seconds. Each impact period is\ninside a communication period (the GTFS-rt spec's rule).",
          "items": {
            "$ref": "#/$defs/AlertPeriod"
          },
          "type": "array"
        },
        "informed": {
          "description": "What it is about. The entities are ORed. At least one.",
          "items": {
            "$ref": "#/$defs/AlertEntity"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity",
          "default": "unknown"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "url": {
          "description": "A link to more about it, in each language.",
          "items": {
            "$ref": "#/$defs/AlertText"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "header",
        "informed"
      ],
      "type": "object"
    },
    "ServiceAlertsKind": {
      "const": "service_alerts"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Every service alert, by its id. The id is the alert's GTFS-rt entity\nid.",
  "properties": {
    "alerts": {
      "additionalProperties": {
        "$ref": "#/$defs/ServiceAlert"
      },
      "type": "object"
    },
    "kind": {
      "$ref": "#/$defs/ServiceAlertsKind",
      "default": "service_alerts",
      "description": "The kind tag and version (D-115). A copy without the version is\nversion 1, which cap-migrate brings forward ([`version`])."
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 2
    }
  },
  "required": [
    "alerts"
  ],
  "title": "ServiceAlerts",
  "type": "object"
}
