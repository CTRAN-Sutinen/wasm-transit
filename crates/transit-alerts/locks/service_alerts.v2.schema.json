{
  "$defs": {
    "AlertCause": {
      "enum": [
        "unknown",
        "other",
        "technical_problem",
        "strike",
        "demonstration",
        "accident",
        "holiday",
        "weather",
        "maintenance",
        "construction",
        "police_activity",
        "medical_emergency",
        "special_event"
      ],
      "type": "string"
    },
    "AlertEffect": {
      "enum": [
        "no_service",
        "reduced_service",
        "significant_delays",
        "detour",
        "additional_service",
        "modified_service",
        "other",
        "unknown",
        "stop_moved",
        "no_effect",
        "accessibility_issue"
      ],
      "type": "string"
    },
    "AlertEntity": {
      "additionalProperties": true,
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ],
          "x-references": "network.route"
        },
        "route_type": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start_secs": {
          "description": "Seconds after the service-day anchor. Needs `trip`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stop": {
          "type": [
            "string",
            "null"
          ],
          "x-references": "network.stop"
        },
        "trip": {
          "type": [
            "string",
            "null"
          ],
          "x-references": "network.trip"
        }
      },
      "type": "object"
    },
    "AlertPeriod": {
      "description": "Unix seconds. An open end is unbounded.",
      "properties": {
        "end": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AlertSeverity": {
      "enum": [
        "unknown",
        "info",
        "warning",
        "severe"
      ],
      "type": "string"
    },
    "AlertSource": {
      "oneOf": [
        {
          "properties": {
            "id": {
              "type": "string",
              "x-references": "edit_record"
            },
            "kind": {
              "const": "edit",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "stop",
              "type": "string"
            },
            "stop": {
              "type": "string",
              "x-references": "stop"
            }
          },
          "required": [
            "kind",
            "stop"
          ],
          "type": "object"
        },
        {
          "description": "A trip instance that the live feed cancels. Version 2.",
          "properties": {
            "date": {
              "type": "string"
            },
            "kind": {
              "const": "trip",
              "type": "string"
            },
            "start_secs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "trip": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "trip",
            "date",
            "start_secs"
          ],
          "type": "object",
          "x-references": "trip_instance"
        }
      ]
    },
    "AlertStatus": {
      "description": "There is no review step (D-207).",
      "enum": [
        "draft",
        "published",
        "retired"
      ],
      "type": "string"
    },
    "AlertText": {
      "description": "A text in one language. No language means the agency's default.",
      "properties": {
        "lang": {
          "description": "A BCP 47 language tag (\"en\", \"es\").",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "ServiceAlert": {
      "additionalProperties": true,
      "properties": {
        "cause": {
          "$ref": "#/$defs/AlertCause",
          "default": "unknown"
        },
        "communication": {
          "items": {
            "$ref": "#/$defs/AlertPeriod"
          },
          "type": "array"
        },
        "description": {
          "items": {
            "$ref": "#/$defs/AlertText"
          },
          "type": "array"
        },
        "effect": {
          "$ref": "#/$defs/AlertEffect",
          "default": "unknown"
        },
        "explains": {
          "items": {
            "$ref": "#/$defs/AlertSource"
          },
          "type": "array"
        },
        "header": {
          "items": {
            "$ref": "#/$defs/AlertText"
          },
          "type": "array"
        },
        "impact": {
          "items": {
            "$ref": "#/$defs/AlertPeriod"
          },
          "type": "array"
        },
        "informed": {
          "items": {
            "$ref": "#/$defs/AlertEntity"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity",
          "default": "unknown"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "url": {
          "items": {
            "$ref": "#/$defs/AlertText"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "header",
        "informed"
      ],
      "type": "object"
    },
    "ServiceAlertsKind": {
      "const": "service_alerts"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "alerts": {
      "additionalProperties": {
        "$ref": "#/$defs/ServiceAlert"
      },
      "type": "object"
    },
    "kind": {
      "$ref": "#/$defs/ServiceAlertsKind",
      "default": "service_alerts"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 2
    }
  },
  "required": [
    "alerts"
  ],
  "title": "ServiceAlerts",
  "type": "object"
}
