{
  "$defs": {
    "MealBreak": {
      "additionalProperties": true,
      "description": "At least `min_secs` off within the first `within_secs` of work.",
      "properties": {
        "min_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "within_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "within_secs",
        "min_secs"
      ],
      "type": "object"
    },
    "Pay": {
      "additionalProperties": true,
      "description": "Pay is in time, not dollars, because operators' rates vary by seniority\n(D-51).",
      "properties": {
        "guarantee_secs": {
          "description": "A run is paid at least this long.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "overtime_after_secs": {
          "description": "Work past this is overtime, paid at `overtime_pct` percent.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "overtime_pct": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "spread_after_secs": {
          "description": "Spread past this earns a premium of `spread_pct` percent of the\ntime past it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "spread_pct": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RecoveryRule": {
      "additionalProperties": true,
      "description": "The larger of `min_secs` and `pct_of_run` percent of the run before the\nwait, rounded up to the second. With no route or service type, the rule\ncovers every trip.",
      "properties": {
        "min_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pct_of_run": {
          "description": "A whole percent of the run time (0 to 1000).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RoutePair": {
      "additionalProperties": true,
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "type": "object"
    },
    "RunRules": {
      "additionalProperties": true,
      "properties": {
        "clear_secs": {
          "description": "Paid time after the last piece (pull-in, sign-off).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_piece_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_platform_secs": {
          "description": "The longest a run may be on the platform (driving and waiting).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_spread_secs": {
          "description": "The longest from report to clear, breaks included.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "meal": {
          "anyOf": [
            {
              "$ref": "#/$defs/MealBreak"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_piece_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "relief_points": {
          "description": "Stop ids where one operator may relieve another. When empty, only at\nthe ends of a block's trips.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report_secs": {
          "description": "Paid time before the first piece (sign-on, pull-out).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "WorkRulesKind": {
      "const": "work_rules"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An empty document is `{\"kind\":\"work_rules\",\"schema_version\":1}`.",
  "properties": {
    "interline": {
      "description": "Set per pair, in either order (D-46). A route follows itself. An\nunlisted pair never interlines.",
      "items": {
        "$ref": "#/$defs/RoutePair"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/WorkRulesKind",
      "default": "work_rules",
      "description": "A copy without a kind tag reads as work rules (D-115)."
    },
    "name": {
      "type": "string"
    },
    "pay": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pay"
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery": {
      "description": "The most specific rule answers. Specificity runs from route with\nservice type, to route, to service type, to neither. With no rule,\nthe terminal's floor applies, which is the smallest authored layover\nthere (D-9).",
      "items": {
        "$ref": "#/$defs/RecoveryRule"
      },
      "type": "array"
    },
    "runs": {
      "$ref": "#/$defs/RunRules"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1,
      "description": "A copy without a version is version 1."
    }
  },
  "title": "WorkRules",
  "type": "object"
}
