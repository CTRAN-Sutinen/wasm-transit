{
  "$defs": {
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "StreetClass": {
      "description": "A mode profile decides what each mode may use. The import does\nnot (D-30).",
      "enum": [
        "motorway",
        "primary",
        "secondary",
        "local",
        "ramp",
        "service",
        "track",
        "path",
        "steps",
        "unknown"
      ],
      "type": "string"
    },
    "StreetsKind": {
      "const": "streets"
    },
    "Way": {
      "properties": {
        "class": {
          "$ref": "#/$defs/StreetClass"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "oneway": {
          "type": "boolean"
        },
        "points": {
          "items": {
            "items": {
              "format": "int32",
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "points",
        "class"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "$ref": "#/$defs/StreetsKind",
      "default": "streets"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1
    },
    "ways": {
      "items": {
        "$ref": "#/$defs/Way"
      },
      "type": "array"
    }
  },
  "required": [
    "ways"
  ],
  "title": "Streets",
  "type": "object"
}
