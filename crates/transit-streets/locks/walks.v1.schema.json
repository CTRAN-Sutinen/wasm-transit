{
  "$defs": {
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "Walk": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "walk_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "to",
        "walk_secs"
      ],
      "type": "object"
    },
    "WalksKind": {
      "const": "walks"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "$ref": "#/$defs/WalksKind",
      "default": "walks"
    },
    "max_walk_secs": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "network_hash": {
      "format": "content-hash",
      "type": "string",
      "x-references": "network"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1
    },
    "speed_mps": {
      "format": "double",
      "type": "number"
    },
    "streets_hash": {
      "format": "content-hash",
      "type": "string",
      "x-references": "streets"
    },
    "walks": {
      "items": {
        "$ref": "#/$defs/Walk"
      },
      "type": "array"
    }
  },
  "required": [
    "streets_hash",
    "network_hash",
    "speed_mps",
    "max_walk_secs",
    "walks"
  ],
  "title": "WalkTable",
  "type": "object"
}
