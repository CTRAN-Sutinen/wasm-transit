{
  "$defs": {
    "PickStatus": {
      "description": "Republishing a retired pick's id restores it.",
      "enum": [
        "published",
        "retired"
      ],
      "type": "string"
    },
    "PlansKind": {
      "const": "plans"
    },
    "PublishedPlan": {
      "additionalProperties": true,
      "properties": {
        "effective_from": {
          "description": "\"YYYY-MM-DD\". A published pick is always dated.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "network_hash": {
          "description": "\"sha256:<hex>\" of the canonical network document.",
          "format": "content-hash",
          "type": "string",
          "x-references": "network"
        },
        "status": {
          "$ref": "#/$defs/PickStatus",
          "default": "published"
        },
        "stops_seq": {
          "description": "Absent when the adoption read no stops, or the pick predates the plans\nlog (D-191).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ],
          "x-references": "log.stops"
        }
      },
      "required": [
        "id",
        "name",
        "effective_from",
        "network_hash"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Picks are sorted by (effective_from, id), one entry per id, so one set of\npicks is one byte sequence.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/PlansKind",
      "default": "plans",
      "description": "A copy without a kind tag reads as the plans document."
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/PublishedPlan"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "plans"
  ],
  "title": "PublishedPlans",
  "type": "object"
}
