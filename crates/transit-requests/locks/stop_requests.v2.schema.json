{
  "$defs": {
    "Attachment": {
      "additionalProperties": true,
      "description": "The deployment names the bucket, the server hands out the link, and only\na signed-in person may read the file.",
      "properties": {
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "description": "\"sha256:\" and the 64 hex digits of the file.",
          "type": "string",
          "x-references": "attachment"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "taken_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "type"
      ],
      "type": "object"
    },
    "Locate": {
      "additionalProperties": true,
      "properties": {
        "called_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "called_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticket": {
          "type": [
            "string",
            "null"
          ]
        },
        "utilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "StopRequest": {
      "additionalProperties": true,
      "description": "C-TRAN's Bus Stop Sign & Shelter Installation Worksheet.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "county": {
          "type": [
            "string",
            "null"
          ]
        },
        "cross_street": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "job": {
          "description": "One of [`JOBS`].",
          "type": "string"
        },
        "locate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locate"
            },
            {
              "type": "null"
            }
          ]
        },
        "marked_by": {
          "description": "One of [`MARKINGS`].",
          "type": [
            "string",
            "null"
          ]
        },
        "marked_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset_ft": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "parcel": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "routes": {
          "description": "A new stop's intent, because no schedule serves it yet. The routes are\nnames the planner writes, not references into the network, because a\nroute can be one that no pick runs yet. `direction` is one of\n[`DIRECTIONS`].",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "One of [`STATUSES`].",
          "type": "string"
        },
        "stop": {
          "type": "string",
          "x-references": "stop"
        },
        "street": {
          "description": "The offset is in feet, measured from the center of the cross street\nor address. The side is one of [`SIDES`].",
          "type": [
            "string",
            "null"
          ]
        },
        "township": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkOrder"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stop",
        "job",
        "status"
      ],
      "type": "object"
    },
    "StopRequestsKind": {
      "const": "stop_requests"
    },
    "WorkOrder": {
      "additionalProperties": true,
      "description": "Shown as the work order system gave it. `id` is the worksheet's Control #.",
      "properties": {
        "id": {
          "default": "",
          "type": "string",
          "x-references": "external.work_order"
        },
        "read_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/StopRequestsKind",
      "default": "stop_requests",
      "description": "A copy without a version reads as v2, since every v1 document is a v2\ndocument. A tagged v1 is brought forward by cap-migrate."
    },
    "requests": {
      "additionalProperties": {
        "$ref": "#/$defs/StopRequest"
      },
      "type": "object"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 2
    }
  },
  "required": [
    "requests"
  ],
  "title": "StopRequests",
  "type": "object"
}
