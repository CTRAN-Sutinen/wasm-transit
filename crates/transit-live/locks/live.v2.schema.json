{
  "$defs": {
    "AlertCause": {
      "enum": [
        "unknown",
        "other",
        "technical_problem",
        "strike",
        "demonstration",
        "accident",
        "holiday",
        "weather",
        "maintenance",
        "construction",
        "police_activity",
        "medical_emergency",
        "special_event"
      ],
      "type": "string"
    },
    "AlertEffect": {
      "enum": [
        "no_service",
        "reduced_service",
        "significant_delays",
        "detour",
        "additional_service",
        "modified_service",
        "other",
        "unknown",
        "stop_moved",
        "no_effect",
        "accessibility_issue"
      ],
      "type": "string"
    },
    "AlertPeriod": {
      "description": "Unix seconds. An open end is unbounded.",
      "properties": {
        "end": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AlertScope": {
      "properties": {
        "date": {
          "description": "\"YYYY-MM-DD\". Absent is the current service day ([`LiveDay::on`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "description": "A model direction of `route`. Present only with `route`.",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stop": {
          "type": [
            "string",
            "null"
          ]
        },
        "trip": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AlertSeverity": {
      "enum": [
        "unknown",
        "info",
        "warning",
        "severe"
      ],
      "type": "string"
    },
    "LiveAlert": {
      "properties": {
        "cause": {
          "$ref": "#/$defs/AlertCause"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "$ref": "#/$defs/AlertEffect"
        },
        "header": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "impact": {
          "description": "The impact period, else the active period. Empty means for as long as\nthe alert is shown.",
          "items": {
            "$ref": "#/$defs/AlertPeriod"
          },
          "type": "array"
        },
        "scopes": {
          "description": "An alert whose entities all fail to resolve is counted in\n`unmatched_alerts`, not kept, so this is never empty.",
          "items": {
            "$ref": "#/$defs/AlertScope"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "cause",
        "effect",
        "severity",
        "header",
        "impact",
        "scopes"
      ],
      "type": "object"
    },
    "LiveKind": {
      "const": "live"
    },
    "LiveStatus": {
      "enum": [
        "early",
        "on_time",
        "late",
        "very_late",
        "no_prediction"
      ],
      "type": "string"
    },
    "LiveStop": {
      "properties": {
        "arrival_delay": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "departure_delay": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "predicted_departure": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scheduled_departure": {
          "description": "Seconds after the service-day anchor. The delay is relative to it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "skipped": {
          "type": "boolean"
        },
        "stop": {
          "type": "string"
        }
      },
      "required": [
        "stop"
      ],
      "type": "object"
    },
    "LiveTrip": {
      "properties": {
        "canceled": {
          "type": "boolean"
        },
        "date": {
          "description": "\"YYYY-MM-DD\". Absent is the current service day ([`LiveDay::on`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/LiveStatus"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/LiveStop"
          },
          "type": "array"
        },
        "trip": {
          "type": "string"
        },
        "worst_delay_secs": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "trip",
        "start_secs",
        "status",
        "stops"
      ],
      "type": "object"
    },
    "LiveVehicle": {
      "properties": {
        "bearing": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "date": {
          "description": "\"YYYY-MM-DD\". Absent is the current service day ([`LiveDay::on`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "delay_secs": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "key": {
          "description": "The vehicle id, else the rt entity id, so it is stable per snapshot.",
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "format": "double",
          "type": "number"
        },
        "lon": {
          "format": "double",
          "type": "number"
        },
        "next_stop": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/LiveStatus"
        },
        "trip": {
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "lat",
        "lon",
        "status"
      ],
      "type": "object"
    },
    "OnTimeWindow": {
      "properties": {
        "early_secs": {
          "default": 0,
          "description": "The default is 0, because a bus that leaves before its time is a\nmissed bus.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "late_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "very_late_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "late_secs",
        "very_late_secs"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alerts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LiveAlert"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/LiveKind",
      "default": "live"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1
    },
    "trips": {
      "items": {
        "$ref": "#/$defs/LiveTrip"
      },
      "type": "array"
    },
    "unmatched_alerts": {
      "default": 0,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "unmatched_trips": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/LiveVehicle"
      },
      "type": "array"
    },
    "window": {
      "$ref": "#/$defs/OnTimeWindow"
    }
  },
  "required": [
    "window",
    "trips",
    "vehicles",
    "unmatched_trips"
  ],
  "title": "LiveDay",
  "type": "object"
}
