{
  "$defs": {
    "DetourPoint": {
      "properties": {
        "lat": {
          "format": "double",
          "type": "number"
        },
        "lon": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "type": "object"
    },
    "Diversion": {
      "additionalProperties": true,
      "properties": {
        "added_secs": {
          "default": 0,
          "description": "Seconds of running time, added from the last kept stop onward.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "detour": {
          "default": null,
          "description": "`None` skips the stops and leaves the alignment unchanged.",
          "items": {
            "$ref": "#/$defs/DetourPoint"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "direction_id": {
          "default": null,
          "description": "`None` means both directions.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "end_date": {
          "format": "date",
          "type": "string"
        },
        "first_kept_stop": {
          "description": "The detour runs between the kept stops, and they stay served.",
          "type": "string",
          "x-references": "network.stop"
        },
        "id": {
          "type": "string"
        },
        "last_kept_stop": {
          "type": "string",
          "x-references": "network.stop"
        },
        "route_id": {
          "type": "string",
          "x-references": "network.route"
        },
        "skipped_stops": {
          "default": [],
          "description": "Never includes the kept stops.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-references": "network.stop"
        },
        "start_date": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "id",
        "route_id",
        "first_kept_stop",
        "last_kept_stop",
        "start_date",
        "end_date"
      ],
      "type": "object"
    },
    "EditRecord": {
      "additionalProperties": true,
      "description": "Exactly one of `diversion` and `cancel`. [`sanitize_records`] drops a\nrecord with neither or both. An absent payload is omitted, never `null`,\nso a diversion record keeps its bytes and its hash.",
      "properties": {
        "cancel": {
          "anyOf": [
            {
              "$ref": "#/$defs/TripCancel"
            },
            {
              "type": "null"
            }
          ]
        },
        "diversion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diversion"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "rev": {
          "description": "Monotonic per id. The writer bumps it on every change.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/EditStatus"
        },
        "updated_at": {
          "description": "Unix epoch milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "status",
        "rev",
        "updated_at"
      ],
      "type": "object"
    },
    "EditStatus": {
      "description": "`Retired` is the tombstone: the record stays so that sync sees the\ndeletion, and the UI hides it.",
      "enum": [
        "draft",
        "submitted",
        "accepted",
        "retired"
      ],
      "type": "string"
    },
    "EditsKind": {
      "const": "edit_records"
    },
    "TripCancel": {
      "additionalProperties": true,
      "description": "The boards list a cancelled trip among the visits that the edits of the\nday took away (D-100). It cancels the whole trip, never from a stop on\n(D-45).\nCover, hold, and swap belong to CAD/AVL (D-212).",
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "start_secs": {
          "default": null,
          "description": "Seconds after the service-day anchor. `None` cancels every instance.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "trip_id": {
          "type": "string",
          "x-references": "network.trip"
        }
      },
      "required": [
        "id",
        "trip_id",
        "date"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/EditsKind"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/EditRecord"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "records"
  ],
  "title": "EditDocument",
  "type": "object"
}
