{
  "$defs": {
    "Attachment": {
      "additionalProperties": true,
      "description": "The deployment names the bucket, the server hands out the link, and only\na signed-in person may read the file.",
      "properties": {
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "description": "\"sha256:\" and the 64 hex digits of the file.",
          "type": "string",
          "x-references": "attachment"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "taken_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "type"
      ],
      "type": "object"
    },
    "Event": {
      "additionalProperties": true,
      "properties": {
        "amenities": {
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "`true` is there, `false` is checked and not there, and absent is not\nrecorded. The agency's own names beside [`AMENITIES`] are\nkept and not checked.",
          "type": "object"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "code": {
          "description": "The number on the sign. It is not unique.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "$ref": "#/$defs/EventKind"
        },
        "fare_zone": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_feed": {
          "description": "The id (hash) of the feed that an import recorded this event from.\nA person's own event has none.",
          "type": [
            "string",
            "null"
          ],
          "x-references": "feed"
        },
        "id": {
          "description": "Unique within its stop (D-166). A write gives an event without one an\nid ([`Stops::identified`]).",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "lat": {
          "description": "WGS 84 degrees.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "level": {
          "type": [
            "string",
            "null"
          ]
        },
        "lon": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "on": {
          "description": "\"YYYY-MM-DD\" in the agency's zone.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "x-references": "stop"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ids in other systems, by system or part name (`sign`, `tms`, `gis`).\nKept and not checked.",
          "type": "object"
        },
        "replaces": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-references": "stop"
        },
        "request": {
          "description": "The id of the stop request that this event carries out. Not\nchecked here, because the requests are their own document.",
          "type": [
            "string",
            "null"
          ],
          "x-references": "stop_request"
        },
        "site": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "A survey may contradict the agency's other data. It is kept as given\n(D-161).",
          "type": "object"
        },
        "spoken_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "street_access": {
          "description": "Whether the stop is reached from the street, not only through its\nstation.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "surveyed_by": {
          "description": "Marks the event as a site survey, dated the day of the survey.",
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "transfer": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "until": {
          "description": "The first service date after a temporary `suspended` or `moved`,\nwhen the earlier state returns.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "wheelchair": {
          "description": "Absent means not recorded.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "EventKind": {
      "enum": [
        "planned",
        "permitted",
        "built",
        "in_service",
        "suspended",
        "moved",
        "changed",
        "retired"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "StopKind": {
      "enum": [
        "stop",
        "station"
      ],
      "type": "string"
    },
    "StopsKind": {
      "const": "stops"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/StopsKind",
      "default": "stops"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": 1
    },
    "stops": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Event"
        },
        "type": "array"
      },
      "description": "The key stays the same through a move.",
      "type": "object"
    }
  },
  "required": [
    "stops"
  ],
  "title": "Stops",
  "type": "object"
}
