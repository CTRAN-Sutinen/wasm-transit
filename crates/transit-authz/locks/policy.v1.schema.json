{
  "$defs": {
    "PolicyKind": {
      "const": "policy"
    },
    "Rule": {
      "additionalProperties": true,
      "description": "`\"*\"` matches all actions or pointers. A rule with empty `roles` never\nmatches.",
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "pointers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "roles"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "$ref": "#/$defs/PolicyKind",
      "default": "policy",
      "description": "A copy without a kind tag reads as a policy."
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "Policy",
  "type": "object"
}
