      "expect": "{\"ok\":{\"op\":\"plan_trip\",\"itinerary\":{\"from_stop_id\":\"A\",\"from_stop_name\":\"Main & 1st\",\"to_stop_id\":\"C\",\"to_stop_name\":\"Main & 3rd\",\"depart_secs\":28800,\"arrival_secs\":29400,\"arrival_hhmmss\":\"08:10:00\",\"legs\":[{\"type\":\"transit\",\"trip_id\":\"10-weekday@28800\",\"route_id\":\"10\",\"route_name\":\"Route 10\",\"headsign\":\"10 inbound via Main\",\"board_stop_id\":\"A\",\"board_stop_name\":\"Main & 1st\",\"board_secs\":28800,\"board_hhmmss\":\"08:00:00\",\"alight_stop_id\":\"C\",\"alight_stop_name\":\"Main & 3rd\",\"alight_secs\":29400,\"alight_hhmmss\":\"08:10:00\"}]}}}"
