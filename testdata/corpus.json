    {
      "name": "plan_trip_compare",
      "request": "{\"op\":\"plan_trip_compare\",\"feed_id\":$FEED,\"from\":\"A\",\"to\":\"B\",\"date\":\"2026-10-23\",\"depart_secs\":27000,\"max_legs\":6}",
      "expect": "{\"ok\":{\"op\":\"plan_trip_compare\",\"active\":{\"from_stop_id\":\"A\",\"from_stop_name\":\"Main & 1st\",\"to_stop_id\":\"B\",\"to_stop_name\":\"Main & 2nd\",\"depart_secs\":27000,\"arrival_secs\":29700,\"arrival_hhmmss\":\"08:15:00\",\"legs\":[{\"type\":\"transit\",\"trip_id\":\"t10\",\"route_id\":\"10\",\"route_name\":\"10\",\"headsign\":\"Downtown\",\"board_stop_id\":\"A\",\"board_stop_name\":\"Main & 1st\",\"board_secs\":28800,\"board_hhmmss\":\"08:00:00\",\"alight_stop_id\":\"B\",\"alight_stop_name\":\"Main & 2nd\",\"alight_secs\":29700,\"alight_hhmmss\":\"08:15:00\"}]},\"baseline\":{\"from_stop_id\":\"A\",\"from_stop_name\":\"Main & 1st\",\"to_stop_id\":\"B\",\"to_stop_name\":\"Main & 2nd\",\"depart_secs\":27000,\"arrival_secs\":29400,\"arrival_hhmmss\":\"08:10:00\",\"legs\":[{\"type\":\"transit\",\"trip_id\":\"t10\",\"route_id\":\"10\",\"route_name\":\"10\",\"headsign\":\"Downtown\",\"board_stop_id\":\"A\",\"board_stop_name\":\"Main & 1st\",\"board_secs\":28800,\"board_hhmmss\":\"08:00:00\",\"alight_stop_id\":\"B\",\"alight_stop_name\":\"Main & 2nd\",\"alight_secs\":29400,\"alight_hhmmss\":\"08:10:00\"}]}}}"
    },
    {
      "name": "stops_geojson",
      "request": "{\"op\":\"stops_geojson\",\"feed_id\":$FEED}",
      "expect": "{\"ok\":{\"op\":\"stops_geojson\",\"collection\":{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[-73.5,45.5]},\"properties\":{\"stop_id\":\"A\",\"name\":\"Main & 1st\",\"code\":null}},{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[-73.51,45.51]},\"properties\":{\"stop_id\":\"B\",\"name\":\"Main & 2nd\",\"code\":null}},{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[-73.52,45.52]},\"properties\":{\"stop_id\":\"C\",\"name\":\"Main & 3rd\",\"code\":null}}]}}}"
    },
    {
      "name": "trip_path_geojson",
      "request": "{\"op\":\"trip_path_geojson\",\"feed_id\":$FEED,\"trip_id\":\"t10\",\"date\":\"2026-10-23\"}",
      "expect": "{\"ok\":{\"op\":\"trip_path_geojson\",\"feature\":{\"type\":\"Feature\",\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[-73.4,45.4],[-73.45,45.45],[-73.5,45.5],[-73.505,45.505],[-73.51,45.51]]},\"properties\":{\"trip_id\":\"t10\",\"route_id\":\"10\",\"route_name\":\"10\"}}}}"
    },
    {
      "name": "block_trips",
      "request": "{\"op\":\"block_trips\",\"feed_id\":$FEED,\"block_id\":\"B1\",\"date\":\"2026-10-23\"}",
      "expect": "{\"ok\":{\"op\":\"block_trips\",\"trips\":[{\"trip_id\":\"t10\",\"route_id\":\"10\",\"route_name\":\"10\",\"service_id\":\"WK\",\"headsign\":\"Downtown\",\"first_stop_id\":\"A\",\"first_stop_name\":\"Main & 1st\",\"start_time\":28800,\"start_time_hhmmss\":\"08:00:00\",\"last_stop_id\":\"B\",\"last_stop_name\":\"Main & 2nd\",\"end_time\":29700,\"end_time_hhmmss\":\"08:15:00\",\"layover_secs\":null},{\"trip_id\":\"t20\",\"route_id\":\"20\",\"route_name\":\"20\",\"service_id\":\"WK\",\"headsign\":\"Downtown\",\"first_stop_id\":\"A\",\"first_stop_name\":\"Main & 1st\",\"start_time\":30000,\"start_time_hhmmss\":\"08:20:00\",\"last_stop_id\":\"B\",\"last_stop_name\":\"Main & 2nd\",\"end_time\":30600,\"end_time_hhmmss\":\"08:30:00\",\"layover_secs\":300}]}}"
    },
    {
      "name": "sync_edits_deterministic",
      "request": "{\"op\":\"sync_edits\",\"feed_id\":$FEED,\"client\":[],\"server\":[],\"now_ms\":1000}",
      "expect": "{\"ok\":{\"op\":\"sync_edits\",\"records\":[],\"reports\":[]}}"
    },
    {
      "name": "network_import",
      "request": "{\"op\":\"network_import\",\"feed_id\":$FEED}",
      "expect": "{\"ok\":{\"op\":\"network_import\",\"network\":{\"name\":\"Test Transit\",\"anchor\":\"noon_minus_twelve\",\"stops\":{\"A\":{\"name\":\"Main & 1st\",\"lat\":45.5,\"lon\":-73.5},\"B\":{\"name\":\"Main & 2nd\",\"lat\":45.51,\"lon\":-73.51},\"C\":{\"name\":\"Main & 3rd\",\"lat\":45.52,\"lon\":-73.52}},\"routes\":{\"10\":{\"name\":\"10\",\"mode\":\"bus\"},\"20\":{\"name\":\"20\",\"mode\":\"bus\"}},\"patterns\":{\"pat-10-0-0\":{\"route\":\"10\",\"name\":\"10 → Main & 2nd\",\"stops\":[{\"stop\":\"A\",\"timepoint\":true,\"distance_m\":0.0},{\"stop\":\"B\",\"timepoint\":true,\"distance_m\":500.0}],\"timing\":[{\"start_secs\":0,\"end_secs\":108000,\"at_timepoints\":[0,600]}]},\"pat-10-0-1\":{\"route\":\"10\",\"name\":\"10 → Main & 2nd\",\"stops\":[{\"stop\":\"A\",\"timepoint\":true,\"distance_m\":0.0},{\"stop\":\"C\",\"timepoint\":true,\"distance_m\":500.0},{\"stop\":\"B\",\"timepoint\":true,\"distance_m\":1000.0}],\"timing\":[{\"start_secs\":0,\"end_secs\":108000,\"at_timepoints\":[0,300,600]}]},\"pat-20-0-0\":{\"route\":\"20\",\"name\":\"20 → Main & 2nd\",\"stops\":[{\"stop\":\"A\",\"timepoint\":true,\"distance_m\":0.0},{\"stop\":\"B\",\"timepoint\":true,\"distance_m\":500.0}],\"timing\":[{\"start_secs\":0,\"end_secs\":108000,\"at_timepoints\":[0,600]}]}},\"calendars\":{\"SUN\":{\"days\":{\"mon\":false,\"tue\":false,\"wed\":false,\"thu\":false,\"fri\":false,\"sat\":false,\"sun\":true},\"ranges\":[{\"start\":\"2026-01-01\",\"end\":\"2026-12-31\"}],\"exceptions\":[]},\"WK\":{\"days\":{\"mon\":true,\"tue\":true,\"wed\":true,\"thu\":true,\"fri\":true,\"sat\":false,\"sun\":false},\"ranges\":[{\"start\":\"2026-01-01\",\"end\":\"2026-12-31\"}],\"exceptions\":[{\"date\":\"2026-10-29\",\"state\":\"removed\"}]}},\"services\":{\"SUN:pat-10-0-0\":{\"pattern\":\"pat-10-0-0\",\"calendar\":\"SUN\",\"schedule\":{\"kind\":\"exact_times\",\"starts\":[32400]}},\"WK:pat-10-0-0\":{\"pattern\":\"pat-10-0-0\",\"calendar\":\"WK\",\"schedule\":{\"kind\":\"exact_times\",\"starts\":[28800]}},\"WK:pat-10-0-1\":{\"pattern\":\"pat-10-0-1\",\"calendar\":\"WK\",\"schedule\":{\"kind\":\"exact_times\",\"starts\":[31200]}},\"WK:pat-20-0-0\":{\"pattern\":\"pat-20-0-0\",\"calendar\":\"WK\",\"schedule\":{\"kind\":\"exact_times\",\"starts\":[30000]}}},\"blocks\":{\"B1\":{\"trips\":[{\"service\":\"WK:pat-10-0-0\",\"start_secs\":28800},{\"service\":\"WK:pat-20-0-0\",\"start_secs\":30000}],\"layovers\":[]}}}}}"
    },
    {
      "name": "network_validate",
      "request": "{\"op\":\"network_validate\",\"network\":{\"name\":\"Planner Network\",\"anchor\":\"noon_minus_twelve\",\"stops\":{\"A\":{\"name\":\"Main & 1st\",\"lat\":45.5,\"lon\":-73.5},\"B\":{\"name\":\"Main & 2nd\",\"lat\":45.51,\"lon\":-73.51},\"C\":{\"name\":\"Main & 3rd\",\"lat\":45.52,\"lon\":-73.52}},\"routes\":{\"10\":{\"name\":\"Route 10\",\"mode\":\"bus\"}},\"patterns\":{\"10-inbound\":{\"route\":\"10\",\"name\":\"10 inbound via Main\",\"stops\":[{\"stop\":\"A\",\"timepoint\":true,\"distance_m\":0},{\"stop\":\"B\",\"timepoint\":false,\"distance_m\":600},{\"stop\":\"C\",\"timepoint\":true,\"distance_m\":1200}],\"timing\":[{\"start_secs\":0,\"end_secs\":108000,\"at_timepoints\":[0,600]}]}},\"calendars\":{\"weekday\":{\"days\":{\"mon\":true,\"tue\":true,\"wed\":true,\"thu\":true,\"fri\":true,\"sat\":false,\"sun\":false},\"ranges\":[{\"start\":\"2026-01-01\",\"end\":\"2026-12-31\"}],\"exceptions\":[{\"date\":\"2026-11-26\",\"state\":\"removed\"}]}},\"services\":{\"10-weekday\":{\"pattern\":\"10-inbound\",\"calendar\":\"weekday\",\"schedule\":{\"kind\":\"exact_times\",\"starts\":[28800,30600,91800]}}},\"blocks\":{\"400\":{\"trips\":[{\"service\":\"10-weekday\",\"start_secs\":28800},{\"service\":\"10-weekday\",\"start_secs\":30600}],\"layovers\":[{\"after_trip\":0,\"secs\":900,\"at\":\"C\"}]}}}}",
