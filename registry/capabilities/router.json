  "op_docs": {
    "load_edits": {
      "description": "Register the operator edit document against a loaded network, validated per record against it; the answer carries the reports and the document's hash. Wholesale replacement, like the host-owned store.",
      "example": null
    },
    "load_network": {
      "description": "Register the network document under its content hash (the same identity the network capability's import produces and every day view consumes; idempotent).",
      "example": null
    },
    "plan": {
      "description": "Earliest-arrival itinerary from stop to stop at a departure time over the materialized day (edits applied when edits_hash names a registered document); null itinerary = unreachable within max_legs. The legs speak model vocabulary: the derived trip identity is (schedule, start_secs).",
      "example": {
        "request": {
          "date": "2026-10-23",
          "depart_secs": 25200,
          "from": "A",
          "max_legs": 4,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "plan",
          "to": "B"
        },
        "response": {
          "ok": {
            "itinerary": {
              "arrival_hhmmss": "08:10:00",
              "arrival_secs": 29400,
              "depart_secs": 25200,
              "from_stop_id": "A",
              "from_stop_name": "Main & 1st",
              "legs": [
                {
                  "alight_hhmmss": "08:10:00",
                  "alight_secs": 29400,
                  "alight_stop_id": "B",
                  "alight_stop_name": "Main & 2nd",
                  "board_hhmmss": "08:00:00",
                  "board_secs": 28800,
                  "board_stop_id": "A",
                  "board_stop_name": "Main & 1st",
                  "headsign": "10 → Main & 2nd",
                  "route_id": "10",
                  "route_name": "10",
                  "schedule": "WK:pat-10-0-0",
                  "start_secs": 28800,
                  "type": "transit"
                }
              ],
              "to_stop_id": "B",
              "to_stop_name": "Main & 2nd"
            },
            "op": "plan"
          }
        }
      }
    },
    "plan_compare": {
      "description": "The diversion delta: the same plan over the patched day (active) and the unpatched materialization (baseline, null when no edit is in force on the date).",
      "example": {
        "request": {
          "date": "2026-10-23",
          "depart_secs": 25200,
          "edits_hash": "sha256:4ab45b2ef7edc302f64bb7d6bd1b4ef49cc5d1afc8a3b3a2af56726b29f9e233",
          "from": "A",
          "max_legs": 4,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "plan_compare",
          "to": "B"
        },
        "response": {
          "ok": {
