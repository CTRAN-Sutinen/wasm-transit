                  "board_hhmmss": "08:00:00",
                  "board_secs": 28800,
                  "board_stop_id": "A",
                  "board_stop_name": "Main & 1st",
                  "headsign": "10 → Main & 2nd",
                  "route_id": "10",
                  "route_name": "10",
                  "schedule": "WK:pat-10-0-0",
                  "start_secs": 28800,
