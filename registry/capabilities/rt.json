  "op_docs": {
    "decode": {
      "description": "Decode a GTFS-rt protobuf payload into the overview (entity counts, trip updates with per-stop delays, vehicle positions), and register the snapshot under its content hash — idempotent, the same bytes are the same snapshot — so trip_progress/late_trips can address it. Bulk-bytes op 0. Garbage bytes are an error outcome, never a trap.",
      "example": {
        "request": {
          "bytes": "<the raw GTFS-rt protobuf — bulk-bytes op 0>",
          "op": "decode"
        },
        "response": {
          "ok": {
            "op": "decode",
            "overview": {
              "alerts": 0,
              "entities": 2,
              "gtfs_realtime_version": "2.0",
              "timestamp": 1728000000,
              "trip_updates": 1,
              "trips": [
                {
                  "route_id": "10",
                  "stop_updates": [
                    {
                      "arrival_delay": null,
                      "departure_delay": 120,
                      "stop_id": "A",
                      "stop_sequence": 1
                    },
                    {
                      "arrival_delay": 180,
                      "departure_delay": null,
                      "stop_id": "B",
                      "stop_sequence": 2
                    }
                  ],
                  "trip_id": "t10"
                }
              ],
              "vehicle_positions": [
                {
                  "bearing": 90.0,
                  "entity_id": "vp-1",
                  "label": "4201",
                  "lat": 45.439998626708984,
                  "lon": -73.44000244140625,
                  "route_id": null,
                  "stop_id": "A",
                  "trip_id": "t10",
                  "vehicle_id": "4201"
                }
              ],
              "vehicles": 1
            }
          }
        }
      }
    },
    "late_trips": {
      "description": "The ranked what's-late-now view: every trip whose worst stop delay reaches min_delay_secs, worst first, each carrying the vehicle's label and position when one names it — and the DELAYED-BUT-DARK flag (has_position false) when none does. vp_hash names the VehiclePositions snapshot (agencies serve it as a SEPARATE feed — C-TRAN does); omit it for combined feeds.",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "min_delay_secs": 60,
          "op": "late_trips",
          "rt_hash": "sha256:e7295600e92977efbe26abd0ec1b4102085f04a743c1690d60f9926c065d7875",
          "vp_hash": null
        },
        "response": {
          "ok": {
            "op": "late_trips",
            "trips": [
              {
                "block_id": "B1",
                "has_position": true,
                "lat": 45.439998626708984,
                "lon": -73.44000244140625,
                "route_id": "10",
                "trip_id": "t10",
                "vehicle_label": "4201",
                "worst_delay_secs": 180
              }
            ]
          }
        }
      }
    },
    "load_feed": {
      "description": "Register the STATIC feed the schedule joins come from — the same GTFS zip bytes gtfs loads, the same content-hash identity (assert equality at the host). Bulk-bytes op 1.",
      "example": null
    },
    "trip_progress": {
      "description": "One trip's joined board: every scheduled stop with the live delay and the PREDICTED time (schedule + delay) — the dispatcher's most-asked question in one op. A trip the snapshot does not mention answers from the schedule alone; a trip the feed does not carry answers null.",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "op": "trip_progress",
          "rt_hash": "sha256:e7295600e92977efbe26abd0ec1b4102085f04a743c1690d60f9926c065d7875",
          "trip_id": "t10"
        },
        "response": {
          "ok": {
            "op": "trip_progress",
            "progress": {
              "block_id": "B1",
              "route_id": "10",
              "stops": [
                {
                  "arrival_delay": null,
                  "departure_delay": 120,
                  "predicted_arrival": 28800,
                  "predicted_departure": 28920,
                  "scheduled_arrival": 28800,
                  "scheduled_departure": 28800,
                  "stop_id": "A",
                  "stop_sequence": 1
                },
                {
                  "arrival_delay": 180,
                  "departure_delay": null,
                  "predicted_arrival": 29580,
                  "predicted_departure": 29400,
                  "scheduled_arrival": 29400,
                  "scheduled_departure": 29400,
                  "stop_id": "B",
                  "stop_sequence": 2
                }
              ],
              "trip_id": "t10",
              "worst_delay_secs": 180
            }
          }
        }
      }
    }
  },
  "ops": [
    "decode",
    "load_feed",
    "trip_progress",
    "late_trips"
  ],
  "purpose": "Realtime decoding and the schedule join: turn a GTFS-rt protobuf payload (trip updates, vehicle positions) into the flat view hosts show, and answer the dispatcher's joined questions — one trip's predicted times, the ranked what's-late-now view with the delayed-but-dark flag. The third capability extracted from the monolith; the domain code lives in the shared transit-rt library. Assemble for riders (live boards) and dispatchers (the operation view) alike.",
  "speaks": {
    "feed": [
      1
    ],
    "gtfs_rt": [
      1
    ]
  }
}
