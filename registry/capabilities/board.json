    "load_watchlist": {
      "description": "Register a watchlist document (the personal saved-set, version-tagged JSON) under its content hash.",
      "example": {
        "request": {
          "document": {
            "stops": [
              {
                "id": "A",
                "label": "home"
              },
              {
                "id": "B",
                "label": "work"
              }
            ],
            "version": "v2"
          },
          "op": "load_watchlist"
        },
        "response": {
          "ok": {
            "op": "load_watchlist",
            "version": 2,
            "watchlist_hash": "sha256:<of the document>"
          }
        }
      }
    },
    "migrate_watchlist": {
      "description": "Migrate a version-1 watchlist to version 2: label = note, colors dropped and reported. Pure and deterministic; the caller keeps the old bytes — migrations never destroy.",
      "example": {
        "request": {
          "document": {
            "stops": [
              {
                "color": "blue",
                "id": "A",
                "note": "home"
              }
            ],
            "version": "v1"
          },
          "op": "migrate_watchlist"
        },
        "response": {
          "ok": {
            "document": {
              "stops": [
                {
                  "id": "A",
                  "label": "home"
                }
              ],
              "version": "v2"
            },
            "notes": [
              {
                "count": 1,
                "field": "color",
                "kind": "dropped_field"
              }
            ],
            "op": "migrated_watchlist"
          }
        }
      }
    },
    "station_departures": {
      "description": "The STATION board: departures pooled over the stop's WALKING GROUP (the model's own transfer-group concept — the stop, its parent, siblings sharing that parent, the parent's children). A station pin answers no departures of its own; its bays carry the trips. Each row carries its concrete stop_id, so the caller sees which bay a departure leaves from.",
      "example": {
        "request": {
          "date": "2026-10-23",
          "from_secs": 25200,
          "limit": 10,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "station_departures",
          "stop_id": "STN"
        },
        "response": {
          "ok": {
            "departures": [
              {
                "departure_secs": 29700,
                "destination": "Main Station: Bay B",
                "pattern": "pat-40-0-0",
                "route": "40",
                "route_name": "40",
                "schedule": "WK:pat-40-0-0",
                "start_secs": 29700,
                "stop": "SA"
              },
              {
