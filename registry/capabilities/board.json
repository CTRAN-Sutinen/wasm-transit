          "date": "2026-10-23",
          "from_secs": 25200,
          "limit": 3,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "watchlist_board",
          "watchlist_hash": "sha256:<of the document>"
        },
        "response": {
