  "hash": "sha256:bf3a3614aa2a783f3f7018fceff0982d0194fd34bc06eda3511587d27700289e",
  "id": "gtfs",
  "kernel": 1,
  "migrates": {},
  "op_docs": {
    "feed_info": {
      "description": "The feed's own metadata (version, publisher), when the feed provides feed_info.txt — the identity question: which feed is this?",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "op": "feed_info"
        },
        "response": {
          "ok": {
            "info": {
              "feed_id": null,
              "feed_lang": "en",
              "feed_publisher_name": "Test Transit",
              "feed_publisher_url": "https://example.com",
              "feed_version": "2026.10.1"
            },
            "op": "feed_info"
          }
        }
      }
    },
    "load_feed": {
      "description": "Register a GTFS zip under its content hash (idempotent). Bulk-bytes op 0; pass the raw zip to transit_invoke_bytes.",
      "example": null
    },
    "stops": {
      "description": "Stop list for UI pickers, first N by id.",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "limit": 3,
          "op": "stops"
        },
        "response": {
          "ok": {
            "op": "stops",
            "stops": [
              {
                "name": "Main & 1st",
                "stop_id": "A"
              },
              {
                "name": "Main & 2nd",
                "stop_id": "B"
              },
              {
                "name": "Main & 3rd",
                "stop_id": "C"
              }
            ]
          }
        }
      }
    },
    "stops_by_ids": {
      "description": "Stop names by id, in the request's order — the join hosts otherwise do by hand when a view (like rt's) carries ids a human reads as names. Unknown ids are omitted.",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "ids": [
            "A",
            "STN"
          ],
          "op": "stops_by_ids"
        },
        "response": {
          "ok": {
            "op": "stops_by_ids",
            "stops": [
              {
                "name": "Main & 1st",
                "stop_id": "A"
              },
              {
                "name": "Main Station",
                "stop_id": "STN"
              }
            ]
          }
        }
      }
    }
  },
  "ops": [
    "load_feed",
    "stops",
    "stops_by_ids",
    "feed_info"
  ],
  "purpose": "The FEED document: parse a GTFS static zip into a hash-addressed feed registry and answer the reads only the feed itself carries — its identity (feed_info), its stop names (the join hosts otherwise do by hand), and the stop list for pickers. The day views are NOT here: they answer over the NETWORK document (the board, runcut, and calendar capabilities — one question, one answer on the bus). Assemble for any user who touches raw feed bytes; it has no ops that author anything.",
  "speaks": {
    "feed": [
      1
    ]
  }
}
