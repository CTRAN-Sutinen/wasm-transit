      "node crates/cap-abi/caps-smoke.mjs (ABI + composition + context)"
    ],
    "recipe": "just registry",
    "rustc": "rustc 1.99.1 (58cf8f9c3 2026-10-13)",
    "source_commit": "bfde95d8fcbf8cfd7778d5738c4c448f92b0ed9b"
  },
  "hash": "sha256:3a477e1cc45b12a38bbfdbc5c5cd824f1458910ccf6eb184b46e6d8d7d7a7a5f",
  "id": "gtfs",
  "kernel": 1,
  "migrates": {
    "watchlist": [
      {
        "from": 1,
        "to": 2
      }
    ]
  },
  "op_docs": {
    "active_services": {
      "description": "Service keys running on a date — often several at once (regular patterns plus exception-added services). The dispatcher's first question: what is running today?",
      "example": {
        "request": {
          "date": "2026-10-23",
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "op": "active_services"
        },
        "response": {
          "ok": {
            "op": "active_services",
            "services": [
              "HOL",
              "WK"
            ]
          }
        }
      }
    },
    "block_trips": {
      "description": "One block's trip chain on a service date: where the vehicle starts, where it ends, the layover between trips. Unknown blocks answer empty, never error.",
      "example": {
        "request": {
          "block_id": "B1",
          "date": "2026-10-23",
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "op": "block_trips"
        },
        "response": {
          "ok": {
            "op": "block_trips",
            "trips": [
              {
                "end_time": 29400,
                "end_time_hhmmss": "08:10:00",
                "first_stop_id": "A",
                "first_stop_name": "Main & 1st",
                "headsign": "Downtown",
                "last_stop_id": "B",
                "last_stop_name": "Main & 2nd",
                "layover_secs": null,
                "route_id": "10",
                "route_name": "10",
                "service_id": "WK",
                "start_time": 28800,
                "start_time_hhmmss": "08:00:00",
                "trip_id": "t10"
              },
              {
                "end_time": 30600,
                "end_time_hhmmss": "08:30:00",
                "first_stop_id": "A",
                "first_stop_name": "Main & 1st",
                "headsign": "Downtown",
                "last_stop_id": "B",
                "last_stop_name": "Main & 2nd",
                "layover_secs": 600,
                "route_id": "20",
                "route_name": "20",
                "service_id": "WK",
                "start_time": 30000,
                "start_time_hhmmss": "08:20:00",
                "trip_id": "t20"
              }
            ]
          }
        }
      }
    },
    "blocks": {
      "description": "All blocks in the feed; with `date`, only the blocks RUNNING that day, with that day's trip counts — the vehicle picker shows buses in service, not parked buses. A block is one vehicle's trip chain.",
      "example": {
        "request": {
          "date": "2026-10-23",
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "op": "blocks"
        },
        "response": {
          "ok": {
            "blocks": [
              {
                "block_id": "B1",
                "trip_count": 2
              },
              {
                "block_id": "B2",
                "trip_count": 1
              }
            ],
            "op": "blocks"
          }
        }
      }
    },
    "departures": {
      "description": "Upcoming departures at one stop on a service date, schedule only (GTFS-rt is another capability). The stop's own board — a station pin answers nothing here; see station_departures.",
      "example": {
        "request": {
          "date": "2026-10-23",
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "from_secs": 25200,
          "limit": 5,
          "op": "departures",
          "stop_id": "A"
        },
        "response": {
          "ok": {
            "departures": [
              {
                "block_id": "B1",
                "departure_time": 28800,
                "departure_time_hhmmss": "08:00:00",
                "headsign": null,
                "route_id": "10",
                "route_name": "10",
                "service_id": "WK",
                "stop_id": "A",
                "stop_sequence": 1,
                "trip_id": "t10"
              },
              {
                "block_id": "B1",
                "departure_time": 30000,
                "departure_time_hhmmss": "08:20:00",
                "headsign": null,
                "route_id": "20",
                "route_name": "20",
                "service_id": "WK",
                "stop_id": "A",
                "stop_sequence": 1,
                "trip_id": "t20"
              }
            ],
            "op": "departures"
          }
        }
      }
    },
    "feed_info": {
      "description": "The feed's own metadata (version, publisher), when the feed provides feed_info.txt — the identity question a dispatcher asks first: which feed am I dispatching?",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "op": "feed_info"
        },
        "response": {
          "ok": {
            "info": {
              "feed_id": null,
              "feed_lang": "en",
              "feed_publisher_name": "Test Transit",
              "feed_publisher_url": "https://example.com",
              "feed_version": "2026.10.1"
            },
            "op": "feed_info"
          }
        }
      }
    },
    "load_feed": {
      "description": "Register a GTFS zip under its content hash (idempotent). Bulk-bytes op 0; pass the raw zip to transit_invoke_bytes.",
      "example": null
    },
    "load_watchlist": {
      "description": "Register a watchlist document (version-tagged JSON) under its content hash.",
      "example": {
        "request": {
          "document": {
            "stops": [
              {
                "id": "A",
                "label": "home"
              },
              {
                "id": "B",
                "label": "work"
              }
            ],
            "version": "v2"
          },
          "op": "load_watchlist"
        },
        "response": {
          "ok": {
            "op": "load_watchlist",
            "version": 2,
            "watchlist_hash": "sha256:<of the document>"
          }
        }
      }
    },
    "migrate_watchlist": {
      "description": "Migrate a version-1 watchlist to version 2: label = note, colors dropped and reported. Pure and deterministic; the caller keeps the old bytes.",
      "example": {
        "request": {
          "document": {
            "stops": [
              {
                "color": "blue",
                "id": "A",
                "note": "home"
              }
            ],
            "version": "v1"
          },
          "op": "migrate_watchlist"
        },
        "response": {
          "ok": {
            "document": {
              "stops": [
                {
                  "id": "A",
                  "label": "home"
                }
              ],
              "version": "v2"
            },
            "notes": [
              {
                "count": 1,
                "field": "color",
                "kind": "dropped_field"
              }
            ],
            "op": "migrated_watchlist"
          }
        }
      }
    },
    "station_departures": {
      "description": "Upcoming departures POOLED over a stop's walking group — the station board. A station (Fisher's Landing, Main Station) answers no departures of its own: the bays carry the trips, and this op unions the whole group (the stop, its parent, siblings sharing that parent, the parent's children), merged by time, each row tagged with its concrete bay. Any member of the group answers the same board.",
      "example": {
        "request": {
          "date": "2026-10-23",
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "from_secs": 25200,
          "limit": 5,
          "op": "station_departures",
          "stop_id": "STN"
        },
        "response": {
          "ok": {
            "departures": [
              {
                "block_id": null,
                "departure_time": 29700,
                "departure_time_hhmmss": "08:15:00",
                "headsign": "Bay B",
                "route_id": "40",
                "route_name": "40",
                "service_id": "WK",
                "stop_id": "SA",
                "stop_sequence": 1,
                "trip_id": "t40"
              },
              {
                "block_id": null,
                "departure_time": 30000,
                "departure_time_hhmmss": "08:20:00",
                "headsign": "Bay B",
                "route_id": "40",
                "route_name": "40",
                "service_id": "WK",
                "stop_id": "SB",
                "stop_sequence": 2,
                "trip_id": "t40"
              },
              {
                "block_id": null,
                "departure_time": 30600,
                "departure_time_hhmmss": "08:35:00",
                "headsign": "Bay A",
                "route_id": "40",
                "route_name": "40",
                "service_id": "WK",
                "stop_id": "SB",
                "stop_sequence": 1,
                "trip_id": "t41"
              },
              {
                "block_id": null,
                "departure_time": 31200,
                "departure_time_hhmmss": "08:40:00",
                "headsign": "Bay A",
                "route_id": "40",
                "route_name": "40",
                "service_id": "WK",
                "stop_id": "SA",
                "stop_sequence": 2,
                "trip_id": "t41"
              }
            ],
            "op": "station_departures"
          }
        }
      }
    },
    "stops": {
      "description": "Stop list for UI pickers, first N by id.",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "limit": 3,
          "op": "stops"
        },
        "response": {
          "ok": {
            "op": "stops",
            "stops": [
              {
                "name": "Main & 1st",
                "stop_id": "A"
              },
              {
                "name": "Main & 2nd",
                "stop_id": "B"
              },
              {
                "name": "Main & 3rd",
                "stop_id": "C"
              }
            ]
          }
        }
      }
    },
    "stops_by_ids": {
      "description": "Stop names by id, in the request's order — the join hosts otherwise do by hand when a view (like rt's) carries ids a human reads as names. Unknown ids are omitted.",
      "example": {
        "request": {
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "ids": [
            "A",
            "STN"
          ],
          "op": "stops_by_ids"
        },
        "response": {
          "ok": {
            "op": "stops_by_ids",
            "stops": [
              {
                "name": "Main & 1st",
                "stop_id": "A"
              },
              {
                "name": "Main Station",
                "stop_id": "STN"
              }
            ]
          }
        }
      }
    },
    "watchlist_board": {
      "description": "Each watched stop's upcoming departures, labelled per the watchlist's version.",
      "example": {
        "request": {
          "date": "2026-10-23",
          "feed_hash": "sha256:a6e69795fd2286b537b897faf833f8f359afaffdf888e08157dba74375a0f2a7",
          "from_secs": 25200,
          "limit": 3,
          "op": "watchlist_board",
          "watchlist_hash": "sha256:<of the document>"
        },
        "response": {
          "ok": {
            "op": "watchlist_board",
            "stops": [
              {
                "departures": [
                  {
                    "block_id": "B1",
                    "departure_time": 28800,
                    "departure_time_hhmmss": "08:00:00",
                    "headsign": null,
                    "route_id": "10",
                    "route_name": "10",
                    "service_id": "WK",
                    "stop_id": "A",
                    "stop_sequence": 1,
                    "trip_id": "t10"
                  }
                ],
                "id": "A",
                "label": "home"
              },
              {
                "departures": [
                  {
                    "block_id": "B2",
                    "departure_time": 27000,
                    "departure_time_hhmmss": "07:30:00",
                    "headsign": "Extra run",
                    "route_id": "20",
                    "route_name": "20",
                    "service_id": "HOL",
                    "stop_id": "B",
                    "stop_sequence": 1,
                    "trip_id": "t12"
                  }
                ],
                "id": "B",
                "label": "work"
              }
            ]
          }
        }
      }
    }
  },
  "ops": [
    "load_feed",
    "departures",
    "station_departures",
    "stops",
    "stops_by_ids",
    "active_services",
    "blocks",
    "block_trips",
    "feed_info",
    "load_watchlist",
    "migrate_watchlist",
    "watchlist_board"
  ],
  "purpose": "Read a GTFS static zip: parse it into a hash-addressed feed registry and answer schedule questions (departures at a stop, stop lists). Assemble for any user who needs to know when service runs. Also owns the watchlist document (the rider's saved stops) and its v1→v2 migration.",
  "speaks": {
    "feed": [
      1
    ],
    "watchlist": [
      1,
      2
    ]
  }
}
