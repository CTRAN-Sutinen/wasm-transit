  "id": "sync",
  "kernel": 1,
  "migrates": {},
  "op_docs": {
    "sync_edits": {
      "description": "Merge the client's edit document with the server's (LWW per record id — the newer updated_at wins, tombstones propagate), then transition drafts to submitted (rev bumped, now_ms stamped). The answer is the converged document; the client adopts it wholesale. The host owns both documents and the clock.",
      "example": {
        "request": {
          "client": [
            {
              "diversion": {
                "added_secs": 300,
                "detour": null,
                "direction_id": null,
                "end_date": "2026-10-23",
                "first_kept_stop": "A",
                "id": "d1",
                "last_kept_stop": "B",
                "route_id": "10",
                "skipped_stops": [
                  "C"
                ],
                "start_date": "2026-10-23"
              },
              "id": "e1",
              "rev": 1,
              "status": "draft",
              "updated_at": 1
            }
          ],
          "now_ms": 1770000000000,
          "op": "sync_edits",
          "server": []
        },
        "response": {
          "ok": {
            "op": "sync_edits",
            "records": [
              {
                "diversion": {
                  "added_secs": 300,
                  "detour": null,
                  "direction_id": null,
                  "end_date": "2026-10-23",
                  "first_kept_stop": "A",
                  "id": "d1",
                  "last_kept_stop": "B",
                  "route_id": "10",
                  "skipped_stops": [
                    "C"
                  ],
                  "start_date": "2026-10-23"
                },
                "id": "e1",
                "rev": 2,
                "status": "submitted",
                "updated_at": 1770000000000
              }
            ]
          }
        }
      }
    }
  },
  "ops": [
    "sync_edits"
  ],
  "purpose": "The sync protocol's one step: what is the converged state of this edit document pair? LWW merge per record id plus tombstones (the terminal authority is the agency scheduling system — propose, review, accept), then drafts transition to submitted with the host-passed clock. transit-sync is the domain library; the module is stateless — document storage is the host's, and validation against the network is every model-side module's load_edits answer, never this one's.",
  "speaks": {
    "operator_edits": [
      1
    ]
  }
}
