  "op_docs": {
    "active_services": {
      "description": "The service keys running on a date: the distinct service types the effective day's trips run under, sorted. Schedule-only when edits_hash is omitted. The day's first question — what is running today?",
      "example": {
        "request": {
          "date": "2026-10-23",
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "active_services"
        },
        "response": {
          "ok": {
            "op": "active_services",
            "services": [
              "WK"
            ]
          }
        }
      }
    },
    "load_edits": {
      "description": "Register the OPERATOR EDIT document against a loaded network, validated per record AGAINST THE NETWORK (model vocabulary — nothing is expanded to answer it). The response carries the reports (invalid records are REPORTED, never rejected — the host owns the document) and the document's content hash, which the day views address. Wholesale replacement: push the whole document on every change.",
      "example": {
        "request": {
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "load_edits",
          "records": [
            {
              "diversion": {
                "added_secs": 300,
                "detour": null,
                "direction_id": null,
                "end_date": "2026-10-23",
                "first_kept_stop": "A",
                "id": "d1",
                "last_kept_stop": "B",
                "route_id": "10",
                "skipped_stops": [
                  "C"
                ],
                "start_date": "2026-10-23"
              },
              "id": "e1",
              "rev": 1,
              "status": "accepted",
              "updated_at": 1
            }
          ]
        },
        "response": {
          "ok": {
            "edits_hash": "sha256:4ab45b2ef7edc302f64bb7d6bd1b4ef49cc5d1afc8a3b3a2af56726b29f9e233",
            "op": "load_edits",
            "reports": [
              {
                "affected_trips": 3,
                "error": null,
                "id": "e1",
                "valid": true
              }
            ]
          }
        }
      }
    },
