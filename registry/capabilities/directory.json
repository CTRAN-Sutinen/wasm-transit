    "route_stop_sequence": {
      "description": "One route's patterns with their ordered stops — the model's directions. An unknown route answers empty, never an error.",
      "example": {
        "request": {
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "route_stop_sequence",
          "route_id": "10"
        },
        "response": {
          "ok": {
            "op": "route_stop_sequence",
            "patterns": [
              {
                "name": "10 → Main & 2nd",
                "pattern": "pat-10-0-0",
                "stops": [
                  {
                    "name": "Main & 1st",
                    "stop_id": "A"
                  },
                  {
                    "name": "Main & 2nd",
                    "stop_id": "B"
                  }
                ]
              },
              {
                "name": "10 → Main & 2nd",
                "pattern": "pat-10-0-1",
                "stops": [
                  {
                    "name": "Main & 1st",
                    "stop_id": "A"
                  },
                  {
                    "name": "Main & 3rd",
                    "stop_id": "C"
                  },
                  {
                    "name": "Main & 2nd",
                    "stop_id": "B"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "routes": {
      "description": "The route list, name-sorted: every route with its mode (the model's closed set, not GTFS's numeric codes) and its authored color when there is one.",
      "example": {
        "request": {
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
