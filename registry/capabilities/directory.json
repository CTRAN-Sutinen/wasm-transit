    "stops": {
      "description": "The stop list, name-sorted (the pickers' shape): every stop with its coords, its parent (the flag the station board keys off), and its transfer flag. limit truncates after the sort; omit it for the whole list — a silently truncated directory would be a lie.",
      "example": {
        "request": {
          "limit": 3,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "stops"
        },
        "response": {
          "ok": {
            "op": "stops",
            "stops": [
              {
                "lat": 45.5,
                "lon": -73.5,
