    "stops_by_ids": {
      "description": "Stops by id, in the request's order — the names join hosts otherwise do by hand when a view (like rt's) carries ids a human reads as names. Unknown ids are omitted.",
      "example": {
        "request": {
          "ids": [
            "A",
            "ghost",
            "STN"
          ],
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
