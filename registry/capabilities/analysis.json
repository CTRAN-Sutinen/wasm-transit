    "network_stats": {
      "description": "The network's numbers on one service date: trips, spans, revenue hours, transfer points, per-route and per-stop activity, headways. include_routes/include_stops/include_service_types (default true) shape the response: false empties the corresponding lists — the day-shape question answers in under a KiB.",
      "example": {
        "request": {
          "date": "2026-01-05",
          "include_routes": false,
          "include_service_types": false,
          "include_stops": false,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "network_stats"
        },
        "response": {
          "ok": {
            "op": "network_stats",
            "stats": {
              "active_routes": 3,
              "active_stops": 5,
              "date": "2026-01-05",
              "first_start_secs": 28800,
              "last_arrival_secs": 31800,
              "revenue_hours": 0.6666666666666666,
              "routes": [],
              "service_types": [],
              "stops": [],
              "transfer_stops": 0,
              "trips": 5
            }
          }
        }
      }
    },
