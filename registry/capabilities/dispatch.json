  "op_docs": {
    "block_trips": {
      "description": "One block's chain on a service date: the AUTHORED runcut (the model's blocks carry layovers GTFS never had), materialized for the day, with the in-force edits applied — a diverted trip ending later eats into the vehicle's next layover, and layover_remaining_secs goes negative when the connection is eaten. Trips of the chain that do not run on the date stay in view, marked. Unknown blocks answer empty, never error.",
      "example": {
        "request": {
          "block_id": "B1",
          "date": "2026-10-23",
          "edits_hash": "<of the loaded edit document>",
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "block_trips"
        },
        "response": {
          "ok": {
            "op": "block_trips",
            "trips": [
              {
                "end_secs": 29700,
                "first_stop": "A",
                "last_stop": "B",
                "layover_after_secs": 600,
                "layover_remaining_secs": 300,
                "pattern": "pat-10-0-0",
                "route": "10",
                "route_name": "10",
                "runs": true,
                "schedule": "WK:pat-10-0-0",
                "start_secs": 28800
              },
              {
                "end_secs": 30600,
                "first_stop": "A",
                "last_stop": "B",
                "layover_after_secs": null,
                "layover_remaining_secs": null,
                "pattern": "pat-20-0-0",
                "route": "20",
                "route_name": "20",
                "runs": true,
                "schedule": "WK:pat-20-0-0",
                "start_secs": 30000
              }
            ]
          }
        }
      }
    },
    "departures": {
      "description": "The board at one stop on a service date: the network's materialized day — trips as their (schedule, start) identity, model vocabulary — with the in-force edits applied when edits_hash names a registered document (schedule-only when omitted). The stop's own board; a station pin answers nothing here, see station_departures.",
      "example": {
        "request": {
          "date": "2026-10-23",
          "from_secs": 25200,
          "limit": 5,
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "departures",
          "stop_id": "A"
        },
        "response": {
          "ok": {
            "departures": [
              {
                "departure_secs": 28800,
                "destination": "Main & 2nd",
                "pattern": "pat-10-0-0",
                "route": "10",
                "route_name": "10",
                "schedule": "WK:pat-10-0-0",
                "start_secs": 28800,
                "stop": "A"
              },
              {
                "departure_secs": 30000,
                "destination": "Main & 2nd",
                "pattern": "pat-20-0-0",
                "route": "20",
                "route_name": "20",
                "schedule": "WK:pat-20-0-0",
                "start_secs": 30000,
                "stop": "A"
              },
              {
                "departure_secs": 31200,
                "destination": "Main & 2nd",
                "pattern": "pat-10-0-1",
                "route": "10",
                "route_name": "10",
                "schedule": "WK:pat-10-0-1",
                "start_secs": 31200,
                "stop": "A"
              }
            ],
            "op": "departures"
          }
        }
      }
    },
    "load_edits": {
      "description": "Register the OPERATOR EDIT document against a loaded network, validated per record AGAINST THE NETWORK (model vocabulary — nothing is expanded to answer it). The response carries the reports (invalid records are REPORTED, never rejected — the host owns the document) and the document's content hash, which the day views address. Wholesale replacement: push the whole document on every change.",
      "example": {
        "request": {
          "network_hash": "sha256:fc9a6eb27b7b918b0a2d282c1c8c0baacc4e7302034e84a132db7c88838ffb42",
          "op": "load_edits",
          "records": [
            {
              "diversion": {
                "added_secs": 300,
                "detour": null,
                "direction_id": null,
                "end_date": "2026-10-23",
                "first_kept_stop": "A",
                "id": "d1",
                "last_kept_stop": "B",
                "route_id": "10",
                "skipped_stops": [
                  "C"
                ],
                "start_date": "2026-10-23"
              },
              "id": "e1",
              "rev": 1,
              "status": "accepted",
              "updated_at": 1
            }
          ]
        },
        "response": {
          "ok": {
            "edits_hash": "sha256:4ab45b2ef7edc302f64bb7d6bd1b4ef49cc5d1afc8a3b3a2af56726b29f9e233",
            "op": "load_edits",
            "reports": [
              {
                "affected_trips": 3,
                "error": null,
                "id": "e1",
                "valid": true
              }
            ]
          }
        }
      }
    },
