      "purpose": "Earliest-arrival trip planning (RAPTOR) over a feed document the gtfs capability produced. Assemble for users who need directions, not just departure times. Reads documents by content hash; writes nothing.",
      "op_docs": {
        "plan": {
          "description": "Earliest-arrival itinerary from stop to stop at a departure time; null itinerary = unreachable within max_legs.",
          "example": {
            "request": {
              "date": "2026-10-23",
              "depart_secs": 25200,
              "feed_hash": "sha256:d87f14e29e498e9e6587448f38ddcfa289df7e9aefbd98d96290beaf57f2f4e2",
              "from": "A",
              "max_legs": 4,
              "op": "plan",
              "to": "B"
            },
            "response": {
              "ok": {
                "itinerary": {
                  "arrival_hhmmss": "08:10:00",
                  "arrival_secs": 29400,
                  "depart_secs": 28800,
                  "from_stop_id": "A",
                  "legs": [],
                  "to_stop_id": "B"
                },
                "op": "plan"
              }
            }
          }
        },
        "load_feed": {
          "description": "Register a GTFS zip under its content hash (the same document identity gtfs returns — assert equality at the host). Bulk-bytes op 0.",
          "example": null
        }
      }
    },
