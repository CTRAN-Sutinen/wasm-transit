      "purpose": "Planner analysis over an authored network document: network/route/stop stats, per-service-type overview and detail, population coverage. The first capability extracted from the monolith — the domain code lives in the shared transit-analysis library. Assemble for planners; riders never download it. Documents are hash-addressed (load once, query by hash — never per-op document serialization).",
      "op_docs": {
        "load_network": {
          "description": "Register an authored network document (the planner's JSON document) under its content hash; idempotent.",
          "example": null
        },
        "service_type_detail": {
          "description": "One service type expanded on its representative day: routes, stops, schedules, totals.",
          "example": null
        },
        "network_stats": {
          "description": "The network's numbers on one service date: trips, spans, revenue hours, per-route and per-stop activity, headways.",
          "example": null
        },
        "service_types_overview": {
          "description": "Every service type's numbers, each on its representative day — the design axis, no calendar dates in sight.",
          "example": null
        },
        "type_coverage": {
          "description": "Population coverage per service type against a hash-addressed layer: what share of the population each type serves, and serves frequently.",
          "example": null
        },
        "load_population_layer": {
          "description": "Register a GeoJSON population layer under its content hash. Bulk-bytes op 0; pop_field optional (common candidates tried).",
          "example": null
        }
      }
    }
  ]
