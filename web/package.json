{
  "name": "rustwasm-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "cargo build --release -p transit-wasm --target wasm32-unknown-unknown && cp ../target/wasm32-unknown-unknown/release/transit_wasm.wasm pkg/transit_wasm.wasm",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^6.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.5"
  }
}